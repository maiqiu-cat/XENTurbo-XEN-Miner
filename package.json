{
  "name": "standalone-miner",
  "version": "1.1.12",
  "description": "XENTurbo XEN Miner - pure frontend batch miner, no backend, no database. All state derived from on-chain data.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "verify:create2": "node scripts/verify-create2.mjs",
    "check:rpc-health": "node scripts/check-rpc-health.mjs",
    "probe:release": "node scripts/probe-release-chain.mjs",
    "check:public-safety": "node scripts/check-public-safety.mjs && node scripts/check-version.mjs",
    "check:version": "node scripts/check-version.mjs",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high --registry=https://registry.npmjs.org",
    "audit:dependencies": "npm audit --audit-level=high --registry=https://registry.npmjs.org",
    "verify": "npm run check:public-safety && npm run lint && npm run format:check && npm run test:coverage && npm run typecheck && npm run build && npm run check:bundle && npm run audit:prod && npm run audit:dependencies && playwright test"
  },
  "dependencies": {
    "ethers": "^6.13.2",
    "pinia": "^2.2.2",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "happy-dom": "21.0.4",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.6",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.7"
  },
  "overrides": {
    "@vue/test-utils": {
      "js-beautify": "2.0.3"
    }
  }
}
